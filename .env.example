# Clerk's Vercel Marketplace integration supplies this key to Vercel builds.
# For local development, run `vercel env pull .env.local` or set a Clerk
# publishable key here. Never add CLERK_SECRET_KEY to a VITE_* variable.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# The salt for the inquiry rate limit (#94). `api/_lib/throttle.ts` hashes the
# caller's address with this value and stores only the hash, so it is a secret in the
# ordinary sense: anyone holding it can confirm whether a given address posted.
#
# There is no default and no fallback, deliberately. The whole IPv4 space is 2^32, so
# an UNSALTED sha256 of an address is an encoding rather than anonymisation — a laptop
# reverses it in minutes. With this unset the limit fails OPEN and logs, which is worse
# than having it set and better than a reversible key that only looks enforced.
#
# Generate one with: openssl rand -hex 32
# Set it in Vercel for Production and Preview. Server-side only — never a VITE_*
# variable, and the browser never needs it.
THROTTLE_SALT=
